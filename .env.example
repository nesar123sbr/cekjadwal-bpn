# Database Configuration (Turso / libSQL)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Admin / Petugas Loket Primary Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Admin / Petugas Loket Secondary Credentials (Opsional, jika diisi keduanya harus lengkap)
ADMIN_USERNAME_2=
ADMIN_PASSWORD_2=

# Session Secret (Wajib di production: string acak minimal 32 karakter)
SESSION_SECRET=your_random_secret_key_minimum_32_characters_long

# Development / Seeding Flag (Hanya untuk lokal, jangan aktifkan di production)
ALLOW_SEED=false

